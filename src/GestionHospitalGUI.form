<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="GestionHospitalGUI">
  <grid id="27dc6" binding="panelPrincipal" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="0" y="0" width="515" height="98"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <scrollpane id="scroll1">
        <constraints border-constraint="Center"/>
        <properties/>
        <border type="none"/>
        <children>
          <component id="areaTexto" class="javax.swing.JTextArea" binding="areaTexto">
            <constraints/>
            <properties>
              <editable value="false"/>
              <font name="Monospaced" size="14"/>
            </properties>
          </component>
        </children>
      </scrollpane>
      <grid id="panelBotones" binding="panelBotones" layout-manager="GridLayoutManager" row-count="2" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="5" left="5" bottom="5" right="5"/>
        <constraints border-constraint="South"/>
        <properties/>
        <border type="none"/>
        <children>
          <component id="btnLimpiar" class="javax.swing.JButton" binding="btnLimpiar">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Limpiar"/>
            </properties>
          </component>
          <component id="btnPresentar" class="javax.swing.JButton" binding="btnPresentar">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Presentar Personas"/>
            </properties>
          </component>
          <component id="btnAccionMedico" class="javax.swing.JButton" binding="btnAccionMedico">
            <constraints>
              <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Acción Médico"/>
            </properties>
          </component>
          <component id="btnAccionPaciente" class="javax.swing.JButton" binding="btnAccionPaciente">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Acción Paciente"/>
            </properties>
          </component>
          <component id="btnAccionCirujano" class="javax.swing.JButton" binding="btnAccionCirujano">
            <constraints>
              <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Acción Cirujano"/>
            </properties>
          </component>
          <component id="btnDependencia" class="javax.swing.JButton" binding="btnDependencia">
            <constraints>
              <grid row="1" column="2" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Procesar Ingreso"/>
            </properties>
          </component>
        </children>
      </grid>
    </children>
  </grid>
</form>
